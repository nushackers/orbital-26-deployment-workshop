{
	"name": "slides",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "slidev build",
		"dev": "slidev --open",
		"export": "slidev export",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"convert:images": "node scripts/convert-public-to-webp.mjs",
		"ttyd": "ttyd -p 7681 -W -t fontSize=15 -t disableLeaveAlert=true zsh"
	},
	"dependencies": {
		"@fontsource/source-code-pro": "^5.2.7",
		"@slidev/cli": "^52.15.0",
		"@slidev/theme-default": "latest",
		"@xterm/addon-fit": "0.10.0",
		"@xterm/addon-web-links": "0.11.0",
		"@xterm/xterm": "5.5.0",
		"coderaft": "^0.0.31",
		"slidev-addon-livecode": "^2.1.2",
		"slidev-addon-liveshell": "^1.0.2",
		"vue": "^3.5.33"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"sharp": "^0.34.5"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"sharp"
		]
	}
}
